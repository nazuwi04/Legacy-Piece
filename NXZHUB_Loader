                            if myHumanoid.Health <= 0 then break end
                            if enemy.Parent then attackEnemy(enemy) end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

local function getPartFromPrompt(prompt)
    if not prompt then return nil end
    local parent = prompt.Parent
    if parent:IsA("BasePart") then
        return parent
    elseif parent:IsA("Model") then
        return parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart", true)
    elseif parent:IsA("Attachment") then
        return parent.Parent:IsA("BasePart") and parent.Parent or nil
    end
    return nil
end

