local function GetConfigList()
    local list = {}
    if isfolder and isfolder(FOLDER_NAME) then
        for _, file in ipairs(listfiles(FOLDER_NAME)) do
            if file:sub(-5) == ".json" and not file:find("autoload.txt") then
                local filename = file:match("([^/\\]+)%.json$")
                if filename then
                    table.insert(list, filename)
                end
            end
        end
    end
    if #list == 0 then
        table.insert(list, "---")
    end
    return list
end

