local function SaveConfigFile(name)
    if name == "" or name == "---" then return end
    local data = {
        AutoFindWhale = AutoFindWhale,
        EnableAutoFishing = EnableAutoFishing,
        AutoHop = AutoHop,
        CONFIG = CONFIG
    }
    local filePath = FOLDER_NAME .. "/" .. name .. ".json"
    if writefile then
        writefile(filePath, HttpService:JSONEncode(data))
        RefreshDropdown()
    end
end

local function LoadConfigFile(name)
    if name == "" or name == "---" then return end
    local filePath = FOLDER_NAME .. "/" .. name .. ".json"
    if isfile and isfile(filePath) and readfile then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(filePath))
        end)
        if success and decoded then
            if AutoFindToggle then AutoFindToggle:Set(decoded.AutoFindWhale or false) end
            if AutoFishToggle then AutoFishToggle:Set(decoded.EnableAutoFishing or false) end
            if AutoHopToggle then AutoHopToggle:Set(decoded.AutoHop or false) end
            if decoded.CONFIG then
                for k, v in pairs(decoded.CONFIG) do
                    CONFIG[k] = v
                end
            end
        end
    end
end

