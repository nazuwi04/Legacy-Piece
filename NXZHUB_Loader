                if obj:IsA("ProximityPrompt") and obj.Enabled then
                    local targetPart = getPartFromPrompt(obj)
                    if targetPart then
                        return obj, targetPart
                    end
                end
            end
        end
    end

    local closestPrompt, closestPart = nil, nil
    local shortestDistance = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local targetPart = getPartFromPrompt(obj)
            if targetPart and Root then
                local dist = (Root.Position - targetPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestPrompt = obj
                    closestPart = targetPart
                end
            end
        end
    end

    return closestPrompt, closestPart
end

local function doChronoPuzzle()
    local prompt, promptPart = nil, nil
    for scanAttempt = 1, 3 do
        prompt, promptPart = findActivePrompt()
        if prompt and promptPart then break end
        task.wait(0.3)
    end

    if not prompt or not promptPart then return false end

    local targetPosition = promptPart.Position + Vector3.new(0, 3, 0)
    forceTweenTo(targetPosition)
    task.wait(0.2)

    local maxRetries, retryCount = 3, 0
    while retryCount < maxRetries do
        if not Root then break end
        if (Root.Position - promptPart.Position).Magnitude <= 8 then break end
        forceTweenTo(targetPosition)
        task.wait(0.3)
        retryCount = retryCount + 1
    end

    if not Root or (Root.Position - promptPart.Position).Magnitude > 8 then return false end

    local sealTool = Character:FindFirstChild(CONFIG.SealWeaponName)
    if not sealTool then
        local backpack = Player:FindFirstChildOfClass("Backpack")
        if backpack then
            sealTool = backpack:FindFirstChild(CONFIG.SealWeaponName)
        end
    end

    if sealTool then
        ensureToolEquipped(sealTool)
        task.wait(0.2)
        
        sealTool:Activate()
        fireSkillRemote(sealTool, CONFIG.SealSkillKey)
        task.wait(0.3)
    end

    if fireproximityprompt then
        fireproximityprompt(prompt, 0)
    else
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration or 0.1)
        prompt:InputHoldEnd()
    end

    task.wait(1.5)
    return true
end

local function startAutoFarmLoop()
    task.spawn(function()
        while true do
            if CONFIG.AutoFarmEnabled then
                for i = 1, CONFIG.PuzzleCount do
                    if not CONFIG.AutoFarmEnabled then break end

                    local success, attempts = false, 0
                    while not success and CONFIG.AutoFarmEnabled and attempts < 10 do
                        success = doChronoPuzzle()
                        if not success then
                            attempts = attempts + 1
                            task.wait(1.5)
                        end
                    end

                    task.wait(CONFIG.BossDelay)
                end
            end
            task.wait(2)
        end
    end)
end

