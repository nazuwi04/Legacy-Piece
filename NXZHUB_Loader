local currentLegacyTween = nil

local function forceTweenTo(targetCFrame)
    if not Character or not Root then
        Character = Player.Character
        if Character then Root = Character:FindFirstChild("HumanoidRootPart") end
    end
    if not Root then return false end

    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end

    Root.Anchored = false
    local targetPos = typeof(targetCFrame) == "CFrame" and targetCFrame.Position or targetCFrame
    local distance = (Root.Position - targetPos).Magnitude
    local time = math.max(distance / CONFIG.TweenSpeed, 0.1)

    if currentLegacyTween then
        currentLegacyTween:Cancel()
    end

    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    currentLegacyTween = TweenService:Create(Root, tweenInfo, {
        CFrame = typeof(targetCFrame) == "CFrame" and targetCFrame or CFrame.new(targetPos)
    })
    
    currentLegacyTween:Play()
    currentLegacyTween.Completed:Wait()
    return true
end

