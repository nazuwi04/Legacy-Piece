local function getInstanceCFrame(instance)
    if not instance then return nil end

    if instance:IsA("Model") then
        local primary = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
        if primary then
            return primary.CFrame
        end
        local cf = instance:GetBoundingBox()
        return cf
    elseif instance:IsA("BasePart") then
        return instance.CFrame
    end

    return nil
end

local function isNearWhale(whale)
    if not whale then return false end

    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local whaleCF = getInstanceCFrame(whale)

    if hrp and whaleCF then
        local dist = (hrp.Position - whaleCF.Position).Magnitude
        return dist <= SAFE_DISTANCE
    end

    return false
end

local function stopCharacterMovement()
    if CurrentWhaleTween then
        CurrentWhaleTween:Cancel()
        CurrentWhaleTween = nil
    end

    local char = Player.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        
        hrp.Anchored = true
        task.wait(0.15)
        hrp.Anchored = false
    end
end

local function tweenToWhale(whale)
    if not AutoFindWhale then return end

    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 3)
    if not hrp then return end

    local destination = getInstanceCFrame(whale)
    if not destination then return end

    local safePosition = destination.Position + Vector3.new(180, 0, 0)
    local safeCFrame = CFrame.new(safePosition, destination.Position)

    local distance = (hrp.Position - safePosition).Magnitude
    local duration = distance / CONFIG.TweenSpeed

    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    stopCharacterMovement()

    CurrentWhaleTween = TweenService:Create(hrp, tweenInfo, { CFrame = safeCFrame })
    CurrentWhaleTween:Play()

    CurrentWhaleTween.Completed:Wait()
    CurrentWhaleTween = nil

    stopCharacterMovement()
end

local function forceEquipRod()
    local char = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = char:WaitForChild("Humanoid", 3)
    if not humanoid then return end

    local heldTool = char:FindFirstChildOfClass("Tool")
    if heldTool and heldTool.Name:lower():find("rod") then
        return
    end

    local rodTool = nil
    for _, item in ipairs(Player.Backpack:GetChildren()) do
        if item:IsA("Tool") and item.Name:lower():find("rod") then
            rodTool = item
            break
        end
    end

    if not rodTool then
        rodTool = Player.Backpack:FindFirstChildOfClass("Tool")
    end

    if rodTool then
        local attempts = 0
        while not (char:FindFirstChildOfClass("Tool") and char:FindFirstChildOfClass("Tool").Name:lower():find("rod")) and attempts < 10 do
            humanoid:EquipTool(rodTool)
            rodTool.Parent = char
            task.wait(0.2)
            attempts += 1
        end
    end
end

local function isAutoFishingActive()
    local playerGui = Player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false end

    local fishMinigame = playerGui:FindFirstChild("FishMinigame")
    if fishMinigame then
        local frame = fishMinigame:FindFirstChild("Frame")
        if frame then
            local autoOn = frame:FindFirstChild("AutoFishingOn")
            if autoOn and autoOn.Visible then
                return true
            end
        end
    end

    return false
end

local function clickAutoFishingButtonDynamic()
    local playerGui = Player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false end

    local fishMinigame = playerGui:FindFirstChild("FishMinigame")
    if fishMinigame then
        local frame = fishMinigame:FindFirstChild("Frame")
        if frame then
            local autoBtn = frame:FindFirstChild("AutoFishing")
            if autoBtn and autoBtn.Visible then
                local guiInset = GuiService:GetGuiInset()
                local pos = autoBtn.AbsolutePosition
                local size = autoBtn.AbsoluteSize

                local tapX = pos.X + (size.X / 2) + 25
                local tapY = pos.Y + (size.Y / 2) + guiInset.Y + 2

                VirtualInputManager:SendMouseButtonEvent(tapX, tapY, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(tapX, tapY, 0, false, game, 1)
                return true
            end
        end
    end
    return false
end

local function enableAndVerifyAutoFish(maxRetries)
    if not EnableAutoFishing then return false end
    maxRetries = maxRetries or 5

    for attempt = 1, maxRetries do
        if isAutoFishingActive() then
            return true
        end

        if InputRemote then
            pcall(function()
                InputRemote:InvokeServer("Settings", "AutoFishing", true)
            end)
        end

        pcall(function()
            clickAutoFishingButtonDynamic()
        end)

        task.wait(0.5)

        if isAutoFishingActive() then
            return true
        end
    end

    return isAutoFishingActive()
end

