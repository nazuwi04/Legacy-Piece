local function sanitizeString(str)
    return string.lower(string.gsub(str, "%s+", ""))
end

local function isToolInCategory(toolName, category)
    local sanitizedTool = sanitizeString(toolName)
    local list = ITEM_DATABASE[category] or ITEM_DATABASE.Abilities

    for _, dbItem in ipairs(list) do
        local sanitizedDbItem = sanitizeString(dbItem)
        if string.find(sanitizedTool, sanitizedDbItem) or string.find(sanitizedDbItem, sanitizedTool) then
            return true
        end
    end
    return false
end

local function fetchCombatTool()
    if not Character then return nil end

    for _, child in ipairs(Character:GetChildren()) do
        if child:IsA("Tool") and child.Name ~= CONFIG.SealWeaponName then
            if isToolInCategory(child.Name, CONFIG.SelectedCategory) then
                return child
            end
        end
    end

    local backpack = Player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and child.Name ~= CONFIG.SealWeaponName then
                if isToolInCategory(child.Name, CONFIG.SelectedCategory) then
                    return child
                end
            end
        end
    end

    local equipped = Character:FindFirstChildOfClass("Tool")
    if equipped and equipped.Name ~= CONFIG.SealWeaponName then
        return equipped
    end

    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and child.Name ~= CONFIG.SealWeaponName then
                return child
            end
        end
    end

    return nil
end

local function ensureToolEquipped(tool)
    if not tool or not Character then return false end
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end

    if tool.Parent ~= Character then
        humanoid:EquipTool(tool)
        task.wait(0.2)
    end
    return tool.Parent == Character
end

local function fireSkillRemote(tool, key)
    if not tool or not Root or not InputRemote then return end
    InputRemote:FireServer("Tool", tool, key, Root.Position)
    InputRemote:FireServer("Skill", key)
end

local function getEnemies()
    local enemies = {}
    local folder = workspace:FindFirstChild(CONFIG.EnemyFolderName)
    if not folder then return enemies end

    for _, enemy in ipairs(folder:GetChildren()) do
        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        local enemyRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
        if humanoid and enemyRoot and humanoid.Health > 0 then
            table.insert(enemies, enemy)
        end
    end
    return enemies
end

local function attackEnemy(enemy)
    local skillIndex = 1

    while enemy and enemy.Parent and CONFIG.AutoKillEnabled do
        local myHumanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        if not myHumanoid or myHumanoid.Health <= 0 then break end

        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        local enemyRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
        if not humanoid or humanoid.Health <= 0 or not enemyRoot then break end

        forceTweenTo(enemyRoot.CFrame * CFrame.new(0, 0, CONFIG.BehindDistance))
        if Root then Root.CFrame = CFrame.lookAt(Root.Position, enemyRoot.Position) end

        local currentTool = fetchCombatTool()
        if currentTool then
            ensureToolEquipped(currentTool)

            if CONFIG.AutoM1Enabled then
                currentTool:Activate()
                if InputRemote then
                    InputRemote:FireServer("M1", currentTool, Root.Position)
                    InputRemote:FireServer("Attack", currentTool)
                    InputRemote:FireServer("Click")
                end
            end

            if CONFIG.UseSkillsInCombat and #CONFIG.ActiveCombatSkillKeys > 0 then
                local activeKey = CONFIG.ActiveCombatSkillKeys[skillIndex]
                if activeKey then
                    fireSkillRemote(currentTool, activeKey)
                end
                skillIndex = (skillIndex % #CONFIG.ActiveCombatSkillKeys) + 1
            end
        end

        task.wait(CONFIG.AttackDelay)
    end

    if Root then Root.Anchored = false end
end

